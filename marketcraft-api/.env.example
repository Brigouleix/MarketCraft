# =============================================================================
#  MarketCraft API — variables d'environnement
#  Copier en .env puis renseigner. Ce fichier-ci ne contient AUCUN secret reel.
# =============================================================================

APP_NAME=MarketCraft
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Europe/Paris
# Sert aussi de base aux URL d'images : APP_URL + /uploads/<fichier>
APP_URL=http://localhost:8001

LOG_CHANNEL=stack
LOG_LEVEL=debug

# --- Base de donnees --------------------------------------------------------
# La base est celle de l'ancien back-end : tables et colonnes en francais.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=marketcraft_4eme_dev
DB_USERNAME=root
DB_PASSWORD=

# --- JWT --------------------------------------------------------------------
# Generer une valeur longue et aleatoire :  php artisan jwt:secret
# Doit faire au moins 32 caracteres.
JWT_SECRET=
JWT_TTL=86400
JWT_REFRESH_TTL=604800

# --- CORS -------------------------------------------------------------------
# Liste separee par des virgules. « * » uniquement en developpement.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Securite de l'authentification ----------------------------------------
# Verrouillage du compte apres N echecs, pendant N minutes.
AUTH_MAX_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15
# Le captcha maison se declenche au-dela de ce nombre d'echecs.
AUTH_CAPTCHA_THRESHOLD=3
AUTH_CAPTCHA_ENABLED=true

# --- Module IA — recommandation personnalisee (option C du CDC) -------------
# Fournisseur au format OpenAI (chat completions).
# Par defaut Mistral : https://console.mistral.ai -> API Keys
# Changer de fournisseur ne demande que de renseigner AI_API_URL et AI_MODEL.
#   Groq        AI_API_URL=https://api.groq.com/openai/v1/chat/completions
#   OpenRouter  AI_API_URL=https://openrouter.ai/api/v1/chat/completions
# Sans cle valide, la recommandation bascule sur un repli par similarite :
# la fonctionnalite se degrade, elle ne casse pas.
AI_API_KEY=
AI_MODEL=mistral-small-latest
AI_API_URL=https://api.mistral.ai/v1/chat/completions
AI_TIMEOUT=12

CACHE_STORE=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
