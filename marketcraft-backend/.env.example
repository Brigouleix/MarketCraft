# Base de données MySQL
DB_HOST=localhost
DB_NAME=marketcraft_3eme_dev
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# JWT
JWT_SECRET=change_me_to_a_long_random_secret_string_at_least_32_chars
JWT_TTL=86400

# Application
APP_URL=http://localhost:8000
APP_ENV=development

# CORS – mettre * en dev, ou une liste séparée par virgules en prod
# Ex : https://marketcraft.com,https://www.marketcraft.com
ALLOWED_ORIGINS=*

# Recherche IA – fournisseur Groq (palier gratuit, sans carte bancaire)
# Créer une clé sur https://console.groq.com/keys ; elle commence par « gsk_ ».
# Sans clé valide, la recherche bascule sur une extraction de mots-clés locale :
# la fonctionnalité se dégrade, elle ne casse pas.
GROQ_API_KEY=

# Modèle utilisé. Laisser vide pour le défaut (openai/gpt-oss-120b).
# Groq retire régulièrement des modèles : en cas d'erreur 400
# « model_decommissioned », voir console.groq.com/docs/deprecations.
GROQ_MODEL=

# Endpoint. L'API étant au format OpenAI, renseigner cette variable suffit
# pour basculer vers un autre fournisseur compatible (Mistral, OpenRouter…).
GROQ_API_URL=
