# Base de données MySQL
DB_HOST=localhost
DB_NAME=marketcraft_3eme_dev
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# JWT
JWT_SECRET=change_me_to_a_long_random_secret_string_at_least_32_chars
JWT_TTL=86400

# Application
APP_URL=http://localhost:8000
APP_ENV=development

# CORS – mettre * en dev, ou une liste séparée par virgules en prod
# Ex : https://marketcraft.com,https://www.marketcraft.com
ALLOWED_ORIGINS=*

# Recherche IA — fournisseur au format OpenAI (chat completions)
#
# Defaut : Mistral (palier gratuit « Experiment »).
#   cle    : https://console.mistral.ai  -> API Keys
#   modele : mistral-small-latest
#
# Le format etant celui d'OpenAI, changer de fournisseur ne demande que de
# renseigner AI_API_URL et AI_MODEL. Exemples :
#   Groq        AI_API_URL=https://api.groq.com/openai/v1/chat/completions
#               AI_MODEL=openai/gpt-oss-120b
#   OpenRouter  AI_API_URL=https://openrouter.ai/api/v1/chat/completions
#
# Sans cle valide, la recherche bascule sur une extraction de mots-cles
# locale : la fonctionnalite se degrade, elle ne casse pas.
AI_API_KEY=

# Laisser vide pour le defaut (mistral-small-latest)
AI_MODEL=

# Laisser vide pour le defaut (endpoint Mistral)
AI_API_URL=
